# OpenAI (GPT-4o 등) — 둘 중 하나 이상 설정
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic (Claude) — OPENAI 대신 사용 가능
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# LLM 제공자: openai | anthropic (미설정 시 키가 있는 쪽 자동)
LLM_PROVIDER=

# SQLite 경로 (기본: data/orders.db)
DATABASE_PATH=data/orders.db
